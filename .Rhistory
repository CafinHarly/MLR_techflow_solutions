PC3$Plataforma <- factor(PC3$Plataforma, levels = c("YouTube","TikTok","Instagram"))
PC3$Creador <- factor(PC3$Creador, levels = c("Micro","Mid","Macro"))
PC3$Categoria <- factor(PC3$Categoria, levels = c("Beauty","Fashion","Consumer_Electronics"))
glimpse(PC3)
#Limpieza inicial
modelo_og <- lm(Ventas ~ .,data=PC3)
modelo0 <- lm(Ventas ~ 1,data=PC3)
step(modelo0, scope = formula(modelo_og), direction ="forward")
modelo_completo <- lm(Ventas ~ ., data = PC3)
modelo_nulo <- lm(Ventas ~ 1, data = PC3)
step(modelo_nulo,
scope = list(lower = modelo_nulo, upper = modelo_completo),
direction = "forward")
forward <- step(modelo_nulo,
scope = list(lower = modelo_nulo, upper = modelo_completo),
direction = "forward")
View(forward)
summary(forward)
AIC(forward)
AIC(step(modelo0, scope = formula(modelo_og), direction ="forward"))
step(modelo0, scope = formula(modelo_og), direction ="forward",trace=F)
ols_hsp(step(modelo0, scope = formula(modelo_og), direction ="forward"))
ols_aic(step(modelo0, scope = formula(modelo_og), direction ="forward"))
#aa
# 1. Fijar la semilla (Estrictamente requerido)
set.seed(2026)
# 2. Definir el tamaño de la muestra (n) y hacer la división 80-20
n <- nrow(PC3) # Tamaño total de la muestra
# Usamos 'sample' para elegir aleatoriamente el 80% de las filas para entrenar
indices_train <- sample(1:n, size = round(0.8 * n))
# Dividimos el conjunto de datos
datos_train <- PC3[indices_train, ]
datos_test <- PC3[-indices_train, ]
# 3. Entrenar el modelo inicial (el obtenido por forward) con los datos de entrenamiento
modelo_cv <- lm(Ventas ~ Espectadores + Publicaciones + Click + Categoria +
Descuento + Creador + Duración + Plataforma,
data = datos_train)
# 4. Calcular predicciones en el conjunto de prueba (20%) usando 'predict'
predicciones_test <- predict(modelo_cv, newdata = datos_test)
# 5. Calcular el Cuadrado Medio del Error (CME) en la prueba
# Fórmula: Suma de errores al cuadrado / cantidad de datos de prueba
errores <- datos_test$Ventas - predicciones_test
CME <- sum(errores^2) / nrow(datos_test)
# 6. Calcular el FPE según la fórmula de tu rúbrica
# Extraemos kc (número de coeficientes incluyendo el intercepto) automáticamente
kc <- length(coef(modelo_cv))
# Aplicamos la fórmula final del examen
fpe <- CME * ((n + kc) / n)
# Mostrar el resultado final
fpe
coef(modelo_cv)
