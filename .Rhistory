library(readxl)
library(tidyverse)
library(nortest)
library(GGally)
library(car)
library(PerformanceAnalytics)
datos <- read_xlsx("Trabajo.xlsx")
datos$Nivel <- factor(datos$Nivel, levels = c("Postgrado","Grado","Tecnico"))
datos$Departamento <- factor(datos$Departamento)
datos$Certificacion <- factor(datos$Certificacion)
datos$Modalidad <- factor(datos$Modalidad)
chart.Correlation(datos,histogram = T)
glimpse(datos)
# Variables significativas ------------------------------------------------
modelo_og <- lm(IPI ~ ., data=datos)
modelo1 <- lm(IPI ~ . - Edad - Distancia - Departamento, data = datos)
summary(modelo_og) #p-value: 2.2e-16
summary(modelo1)
vif(modelo_og)
# Análisis de residuales --------------------------------------------------
ad.test(modelo1$residuals)
library(lmtest)
bptest(modelo)
bptest(modelo1)
ad.test(modelo1.1$residuals)
#Intentando transformación
modelo1.1 <- lm(formula = IPI ~ Antiguedad + Horas + Presupuesto + Satisfaccion_Clima + Nivel + Modalidad + Certificacion, data = datos)
ad.test(modelo1.1$residuals)
#Intentando transformación
modelo1.1 <- lm(formula = IPI ~ Antiguedad + Horas + log(Presupuesto) + Satisfaccion_Clima + Nivel + Modalidad + Certificacion, data = datos)
ad.test(modelo1.1$residuals)
bptest(modelo1.1)
dwtest(modelo1.1, alternative = "t")
library(olsrr)
# Análisis de residuales --------------------------------------------------
ols_pred_rsq(modelo1)
ols_plot_resid_stand()
ols_plot_resid_stand(modelo1)
