library(readxl)
library(tidyverse)
library(GGally)
library(PerformanceAnalytics)
datos <- read_xlsx("Trabajo.xlsx")
datos$Nivel <- factor(datos$Nivel, levels = c("Postgrado","Grado","Tecnico"))
datos$Departamento <- factor(datos$Departamento)
datos$Certificacion <- factor(datos$Certificacion)
datos$Modalidad <- factor(datos$Modalidad)
chart.Correlation(datos,histogram = T)
glimpse(datos)
glimpse(datos)
summary(lm(IPI ~ . , data = datos))
# Seleccionamos explícitamente tus 7 variables numéricas
chart.Correlation(datos[, c("IPI", "Antiguedad", "Horas", "Edad", "Presupuesto", "Distancia", "Satisfaccion_Clima")], histogram = TRUE)
summary(lm(IPI ~ . , data = datos))
# Variables significativas ------------------------------------------------
modelo_og <- lm(IPI ~ . , data = datos)
summary(modelo_og) #p-value: 2.2e-16
anova(lm(IPI ~ . - Edad,data=datos))
anova(lm(IPI ~ . - Edad,data=datos),modelo_og)
summary(modelo_og) #p-value: 2.2e-16
# Variables significativas ------------------------------------------------
modelo_og <- lm(IPI ~ . - Edad, data = datos)
summary(modelo_og) #p-value: 2.2e-16
anova(lm(modelo_og-Distancia),modelo_og)
anova(formula(modelo_og-Distancia),modelo_og)
anova(update(modelo_og, . ~ . - Distancia), modelo_og)
# Variables significativas ------------------------------------------------
modelo_og <- lm(IPI ~ . - Edad, data = datos)
summary(modelo_og) #p-value: 2.2e-16
anova(update(modelo_og, . ~ . - Distancia), modelo_og)
anova(update(modelo_og, . ~ . - Distancia), modelo_og)
# Variables significativas ------------------------------------------------
modelo_og <- lm(IPI ~ . - Edad - Distancia, data = datos)
summary(modelo_og) #p-value: 2.2e-16
anova(formula(modelo_og) - Departamento, modelo_og)
anova(update(modelo_og, . ~ . - Departamento),modelo_og)
summary(modelo_og) #p-value: 2.2e-16
update(modelo_og, . ~ . - Departamento
summary(modelo_og) #p-value: 2.2e-16
# Variables significativas ------------------------------------------------
modelo_og <- lm(IPI ~ . - Edad - Distancia, data = datos)
update(modelo_og, . ~ . - Edad - Distancia)
summary(modelo_og) #p-value: 2.2e-16
# Variables significativas ------------------------------------------------
modelo_og <- lm(IPI ~ . - Edad - Distancia, data = datos)
modelo_og
update(modelo_og, . ~ . - Edad - Distancia)
update(modelo_og, . ~ . - Edad - Distancia)
anova(update(modelo_og, . ~ . - Departamento),modelo_og)
# Variables significativas ------------------------------------------------
modelo_og <- lm(IPI ~ . - Edad - Distancia - Departamento, data = datos)
summary(modelo_og) #p-value: 2.2e-16
# Variables significativas ------------------------------------------------
modelo1 <- lm(IPI ~ . - Edad - Distancia - Departamento, data = datos)
# Variables significativas ------------------------------------------------
modelo_og <- lm(IPI ~ ., data=datos)
modelo1 <- lm(IPI ~ . - Edad - Distancia - Departamento, data = datos)
summary(modelo_og) #p-value: 2.2e-16
summary(modelo1)
anova(update(modelo1, . ~ . - Certificacion),modelo1)
summary(modelo1)
library(car)
vif(modelo_og)
summary(modelo1)$coefficients
library(nortest)
# Análisis de residuales --------------------------------------------------
ad.test(modelo1)
# Análisis de residuales --------------------------------------------------
ad.test(modelo1$residuals)
