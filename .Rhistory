betssubsets <- function(modelo){
df <- ols_step_all_possible(modelo)$result
f_r2 <- which.max(df$rsquare)
f_adjr  <- which.max(df$adjr)
f_aic   <- which.min(df$aic)
f_sbic  <- which.min(df$sbic)
f_cp    <- which.min(df$cp)
tabla_indicadores <- data.frame(
Indicador = c("Mayor R2", "Mayor R2 Ajustado", "Menor AIC", "Menor BIC", "Menor Mallows Cp"),
Valor     = c(df$rsquare[f_r2], df$adjr[f_adjr], df$aic[f_aic], df$sbic[f_sbic], df$cp[f_cp]),
Modelo    = c(df$predictors[f_r2], df$predictors[f_adjr], df$predictors[f_aic], df$predictors[f_sbic], df$predictors[f_cp]),
stringsAsFactors = FALSE
)
modelos_ganadores <- tabla_indicadores$Modelo
conteos <- list()
for (mod in modelos_ganadores) {
if (mod %in% names(conteos)) {
conteos[[mod]] <- conteos[[mod]] + 1
} else {
conteos[[mod]] <- 1
}
}
# Encontrar cuál tuvo el conteo máximo
max_repeticiones <- 0
modelo_mas_frecuente <- ""
for (mod in names(conteos)) {
if (conteos[[mod]] > max_repeticiones) {
max_repeticiones <- conteos[[mod]]
modelo_mas_frecuente <- mod
}
}
# Construir la Tabla 2: Consenso
tabla_consenso <- data.frame(
Modelo_Mas_Repetido = modelo_mas_frecuente,
Veces_Elegido = max_repeticiones,
Total_Criterios = length(modelos_ganadores),
stringsAsFactors = FALSE
)
# 5. Guardar ambas tablas en una LISTA para poder devolverlas juntas
resultado_final <- list(
Resumen_Indicadores = tabla_indicadores,
Modelo_Consenso = tabla_consenso
)
return(resultado_final)
}
a <- betssubsets(modelo_og)
View(a)
a[["Resumen_Indicadores"]]
View(a[["Resumen_Indicadores"]])
View(a[["Modelo_Consenso"]])
obtener_mejor_lm <- function(modelo_base) {
# 1. Correr todas las combinaciones posibles
todos_los_modelos <- ols_step_all_possible(modelo_base)
df <- as.data.frame(todos_los_modelos)
# 2. Índices de los mejores modelos
f_r2    <- which.max(df$rsquare)
f_adjr  <- which.max(df$adjr)
f_aic   <- which.min(df$aic)
f_sbic  <- which.min(df$sbic)
f_cp    <- which.min(df$cp)
# 3. Guardar los predictores ganadores en un vector
modelos_ganadores <- c(
df$predictors[f_r2],
df$predictors[f_adjr],
df$predictors[f_aic],
df$predictors[f_sbic],
df$predictors[f_cp]
)
# 4. Tabla de Resumen para imprimir (Visualización)
tabla_indicadores <- data.frame(
Indicador = c("Mayor R2", "Mayor R2 Ajustado", "Menor AIC", "Menor BIC", "Menor Mallows Cp"),
Valor     = c(df$rsquare[f_r2], df$adjr[f_adjr], df$aic[f_aic], df$sbic[f_sbic], df$cp[f_cp]),
Modelo    = modelos_ganadores,
stringsAsFactors = FALSE
)
# 5. Encontrar el modelo más repetido (Consenso)
conteos <- list()
for (mod in modelos_ganadores) {
if (mod %in% names(conteos)) {
conteos[[mod]] <- conteos[[mod]] + 1
} else {
conteos[[mod]] <- 1
}
}
max_repeticiones <- 0
string_modelo_ganador <- ""
for (mod in names(conteos)) {
if (conteos[[mod]] > max_repeticiones) {
max_repeticiones <- conteos[[mod]]
string_modelo_ganador <- mod
}
}
# Tabla de consenso para imprimir
tabla_consenso <- data.frame(
Modelo_Mas_Repetido = string_modelo_ganador,
Veces_Elegido = max_repeticiones,
Total_Criterios = length(modelos_ganadores),
stringsAsFactors = FALSE
)
# --- IMPRIMIR LAS TABLAS EN CONSOLA ---
cat("\n=== TABLA 1: MEJORES MODELOS POR CRITERIO ===\n")
print(tabla_indicadores)
cat("\n=== TABLA 2: MODELO POR CONSENSO ===\n")
print(tabla_consenso)
cat("\n=============================================\n\n")
# 6. CONVERTIR EL STRING GANADOR A UN OBJETO lm()
# Extraemos la variable dependiente (Y) del modelo original
variable_y <- as.character(formula(modelo_base)[2])
# Reemplazamos los espacios en blanco del string por el signo '+' para la fórmula
predictores_formateados <- gsub(" ", " + ", string_modelo_ganador)
# Construimos el texto de la nueva fórmula: "Y ~ x1 + x2 + x3"
texto_formula <- paste(variable_y, "~", predictores_formateados)
# Convertimos el texto a una fórmula real de R y actualizamos el modelo
formula_final <- as.formula(texto_formula)
modelo_lm_final <- update(modelo_base, formula = formula_final)
# Retornamos el objeto lm
return(modelo_lm_final)
}
obtener_mejor_lm(modelo_og)
